# Demo mode — no external database required
NEXT_PUBLIC_DEMO_MODE=true

# Arc USDC. Leave ARC_MODE unset (or mock) so the demo runs with no keys.
# testnet uses viem against Arc Testnet. Mainnet is not enabled.
# Values below were checked against docs.arc.io on 9 Nov 2026.
# ARC_MODE=mock
# ARC_MODE=testnet
# ARC_RPC_URL=https://rpc.testnet.arc.io
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional: Supabase is no longer used by EasternBlock demo.
# Legacy placeholders (not required):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
