# Demo mode — no external database required.
# Accounts, balances, and history live in this browser (httpOnly cookie,
# with a localStorage backup that does not include signing keys).
NEXT_PUBLIC_DEMO_MODE=true

# Arc USDC. Leave ARC_MODE unset (or mock) so the demo runs with no keys
# and no network. Set the three lines below to talk to Arc testnet with viem.
# Mainnet is not enabled.
# Values checked against https://docs.arc.network on 19 Nov 2026.
# ARC_MODE=testnet
# ARC_RPC_URL=https://rpc.testnet.arc.io
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional: Supabase is no longer used by EasternBlock demo.
# Legacy placeholders (not required):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
